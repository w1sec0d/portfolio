---
import ProjectVisual from './ProjectVisual.astro';
import { routes, t, type Locale } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  locale: Locale;
  index: number;
}

const { project, locale, index } = Astro.props;
const ui = t(locale);
const href = routes.project(project.slug, locale);
---

<article class="project-row" aria-labelledby={`project-${project.slug}-title`}>
  <div class="project-copy">
    <div class="project-index mono">
      <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
      <span class="index-line" aria-hidden="true"></span>
      <span>{project.category[locale]}</span>
      {project.year && <span class="index-year">/ {project.year}</span>}
    </div>

    <h3 class="project-name" id={`project-${project.slug}-title`}>
      <a href={href}>{project.name}</a>
    </h3>

    <p class="project-summary">{project.summary[locale]}</p>

    <p class="project-contribution">
      <span class="mono">{ui.projects.contribution}</span>
      {project.contribution[locale]}
    </p>

    <ul class="project-tech" aria-label={ui.projects.stack}>
      {project.technologies.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="project-links">
      <a class="project-cta" href={href}>{ui.projects.openProject}</a>
      {
        project.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${ui.projects[link.key]} — ${link.href}`}
          >
            {ui.projects[link.key]}
          </a>
        ))
      }
    </div>
  </div>

  <div class="project-visual">
    <ProjectVisual
      visual={project.visual}
      locale={locale}
      name={project.name}
      decorative={true}
    />
  </div>
</article>

<style>
  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
    border-top: 1px solid var(--border);
    align-items: start;
  }

  .project-index {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .index-num {
    color: var(--orange);
  }

  .index-line {
    width: 1.6rem;
    height: 1px;
    background: var(--border-strong);
    flex: none;
  }

  .index-year {
    color: var(--muted-dim);
  }

  .project-name {
    margin-top: 0.65rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .project-name a:hover {
    color: var(--orange-hover);
  }

  .project-summary {
    max-width: 50ch;
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .project-contribution {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .project-contribution .mono {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.66rem;
    color: var(--muted-dim);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-dim);
  }

  .project-tech li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-tech li:not(:last-child)::after {
    content: '/';
    color: var(--border-strong);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    margin-top: 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-links a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.1rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .project-links a:hover {
    color: var(--orange-hover);
    border-color: var(--orange);
  }

  .project-links .project-cta {
    color: var(--text);
  }

  .project-visual {
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .project-row:hover .project-visual {
    border-color: var(--border-strong);
  }

  @media (max-width: 860px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .project-visual {
      max-width: 560px;
    }
  }
</style>
