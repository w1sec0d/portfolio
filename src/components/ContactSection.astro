---
import { t, type Locale } from '../i18n';
import { ASSETS, SITE, SOCIALS } from '../data/site';
import { publicFileExists } from '../lib/assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const cvPath = ASSETS.cv[locale];
const cvAvailable = publicFileExists(cvPath);
---

<section id="contact" class="section contact" aria-labelledby="contact-heading">
  <div class="container contact-grid">
    <div class="contact-intro">
      <p class="mono">{ui.contact.label}</p>
      <h2 id="contact-heading">{ui.contact.title}</h2>
      <p class="lede contact-note">{ui.contact.note}</p>
    </div>

    <div class="contact-panel">
      <p class="mono contact-label">{ui.contact.email}</p>
      <a class="contact-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>

      <p class="mono contact-label">{ui.contact.socials}</p>
      <ul class="contact-socials">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={SITE.links[social.key]}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="mono">{social.label}</span>
                <span class="handle">{social.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="contact-cv">
        {
          cvAvailable ? (
            <a class="btn btn-primary" href={cvPath} download>
              {ui.hero.downloadCv}
            </a>
          ) : (
            <span class="btn btn-secondary is-disabled" aria-disabled="true">
              {ui.contact.cv} · {ui.contact.cvPending}
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contact h2 {
    max-width: 14ch;
    margin-top: 0.9rem;
    font-size: var(--step-4);
  }

  .contact-note {
    max-width: 42ch;
    margin-top: 1.25rem;
  }

  .contact-panel {
    padding-left: clamp(1.5rem, 4vw, 3rem);
    border-left: 1px solid var(--border);
  }

  .contact-label {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.66rem;
    color: var(--muted-dim);
  }

  .contact-label:not(:first-child) {
    margin-top: 2rem;
  }

  .contact-email {
    display: inline-block;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--orange);
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .contact-email:hover {
    color: var(--orange-hover);
  }

  .contact-socials {
    border-top: 1px solid var(--border);
  }

  .contact-socials a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .contact-socials .mono {
    font-size: 0.68rem;
    color: var(--text);
  }

  .contact-socials .handle {
    color: var(--muted-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .contact-socials a:hover .mono {
    color: var(--orange-hover);
  }

  .contact-cv {
    margin-top: 1.75rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      padding-left: 0;
      padding-top: 1.75rem;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
