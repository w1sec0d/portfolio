---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { routes, t, type Locale } from '../i18n';
import { SITE } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const pathname = Astro.url.pathname;

const items = [
  { key: 'home', href: routes.home[locale], label: ui.nav.home },
  { key: 'projects', href: routes.projects[locale], label: ui.nav.projects },
  { key: 'about', href: routes.about[locale], label: ui.nav.about },
  { key: 'contact', href: routes.contact[locale], label: ui.nav.contact },
] as const;

function isActive(key: (typeof items)[number]['key']): boolean {
  if (key === 'home') {
    return pathname === routes.home[locale];
  }
  if (key === 'projects') {
    return pathname.startsWith(routes.projects[locale]);
  }
  if (key === 'about') {
    return pathname === routes.about[locale];
  }
  return false;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={routes.home[locale]} aria-label={`${SITE.shortName} — ${ui.nav.home}`}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <path d="M3 17V8.2L11 3l8 5.2V17" stroke="currentColor" stroke-width="1.3" />
          <circle cx="3" cy="17" r="1.6" fill="currentColor" />
          <circle cx="19" cy="17" r="1.6" fill="currentColor" />
          <circle cx="11" cy="3" r="1.6" fill="currentColor" />
          <path d="M3 17h16" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity=".55" />
        </svg>
      </span>
      <span class="brand-text">{SITE.shortName}</span>
    </a>

    <nav class="desktop-nav" aria-label={ui.nav.primary}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.key) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher locale={locale} />
      <details class="mobile-menu">
        <summary>
          <span class="menu-glyph" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="sr-only">{ui.nav.menu}</span>
        </summary>
        <nav class="mobile-nav" aria-label={ui.nav.mobile}>
          <ul>
            {
              items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.key) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    color: var(--orange);
  }

  .brand-text {
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 1.9rem);
  }

  .desktop-nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .desktop-nav a:hover {
    color: var(--text);
  }

  .desktop-nav a[aria-current='page'] {
    color: var(--text);
  }

  .desktop-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 1px;
    background: var(--orange);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-glyph {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }

  .menu-glyph span {
    display: block;
    width: 14px;
    height: 1px;
    background: currentColor;
  }

  .mobile-menu[open] .menu-glyph span:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }

  .mobile-menu[open] .menu-glyph span:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  .mobile-nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    min-width: 13rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .mobile-nav ul {
    display: grid;
  }

  .mobile-nav a {
    display: block;
    padding: 0.65rem 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
    border-radius: var(--radius);
  }

  .mobile-nav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--orange);
  }

  @media (max-width: 820px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: inline-block;
    }
  }

  @media (max-width: 420px) {
    .brand-text {
      font-size: 0.9rem;
    }
  }
</style>
