---
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import { routes, t, type Locale } from '../i18n';
import { projects } from '../data/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<section id="selected-projects" class="section">
  <div class="container">
    <SectionHead
      label={ui.projects.selectedLabel}
      title={ui.projects.selectedTitle}
      note={ui.projects.selectedNote}
    />

    <div class="project-list">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} locale={locale} index={index} />
        ))
      }
    </div>

    <div class="selected-footer">
      <a class="btn btn-secondary" href={routes.projects[locale]}>
        {ui.projects.viewAll}
      </a>
    </div>
  </div>
</section>

<style>
  .selected-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }
</style>
