---
import type { Locale } from '../i18n';
import type { ProjectVisual } from '../data/projects';
import { publicFileExists } from '../lib/assets';

interface Props {
  visual: ProjectVisual;
  locale: Locale;
  name: string;
  decorative?: boolean;
  src?: string;
  alt?: string;
  fit?: 'cover' | 'contain';
}

const { visual, locale, name, decorative = false, src, alt, fit } = Astro.props;

const copy = {
  en: {
    ciclomart: {
      listing: 'LISTING',
      verify: 'VERIFY',
      cart: 'CART',
      payment: 'PAYMENT',
      catalog: 'CATALOG',
      media: 'MEDIA',
      db: 'DATABASE',
    },
    courseclash: {
      web: 'NEXT.JS',
      gateway: 'GATEWAY',
      auth: 'AUTH',
      activities: 'ACTIVITIES',
      duels: 'DUELS',
      ws: 'WS',
      bus: 'AMQP',
    },
    cyclingsafety: {
      imu: 'IMU',
      gps: 'GPS',
      esp: 'ESP32',
      model: 'TFLM / INT8',
      mqtt: 'MQTT',
      tb: 'THINGSBOARD',
      sd: 'microSD',
      signal: 'ACCEL / GYRO',
      event: 'RISK EVENT',
    },
  },
  es: {
    ciclomart: {
      listing: 'PUBLICAR',
      verify: 'VERIFICAR',
      cart: 'CARRITO',
      payment: 'PAGO',
      catalog: 'CATÁLOGO',
      media: 'MEDIOS',
      db: 'BASE DE DATOS',
    },
    courseclash: {
      web: 'NEXT.JS',
      gateway: 'PASARELA',
      auth: 'AUTENTICACIÓN',
      activities: 'ACTIVIDADES',
      duels: 'DUELOS',
      ws: 'WS',
      bus: 'AMQP',
    },
    cyclingsafety: {
      imu: 'IMU',
      gps: 'GPS',
      esp: 'ESP32',
      model: 'TFLM / INT8',
      mqtt: 'MQTT',
      tb: 'THINGSBOARD',
      sd: 'microSD',
      signal: 'ACEL / GIRO',
      event: 'EVENTO DE RIESGO',
    },
  },
}[locale];

const label =
  locale === 'es'
    ? `Diagrama de arquitectura de ${name}`
    : `${name} architecture diagram`;
const gridId = `pv-grid-${visual}`;
const arrowId = `pv-arrow-${visual}`;
---

{src && publicFileExists(src) ? (
  <img
    class:list={['screenshot', { 'screenshot-contain': fit === 'contain' }]}
    src={src}
    alt={decorative ? '' : (alt ?? label)}
    width="1600"
    height="1024"
    loading="lazy"
    decoding="async"
    aria-hidden={decorative ? 'true' : undefined}
  />
) : (
<svg
  class="diagram"
  viewBox="0 0 500 320"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : label}
>
  <defs>
    <pattern id={gridId} width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0v24" fill="none" stroke="#28303A" stroke-width="0.5" opacity="0.35" />
    </pattern>
    <marker
      id={arrowId}
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M0 0L8 4L0 8z" fill="#5A6674" />
    </marker>
  </defs>

  <rect width="500" height="320" fill="#0D1014" />
  <rect width="500" height="320" fill={`url(#${gridId})`} />

  {
    visual === 'ciclomart' && (
      <>
        <g
          fill="#12161B"
          stroke="#3A4653"
          stroke-width="1"
        >
          <rect x="24" y="36" width="120" height="38" rx="2" />
          <rect x="356" y="36" width="130" height="38" rx="2" />
          <rect x="24" y="130" width="92" height="44" rx="2" />
          <rect x="150" y="130" width="92" height="44" rx="2" />
          <rect x="276" y="130" width="92" height="44" rx="2" />
          <rect x="402" y="130" width="84" height="44" rx="2" stroke="#F97316" stroke-width="1.2" />
          <rect x="150" y="232" width="222" height="38" rx="2" />
        </g>

        <g
          stroke="#3A4653"
          stroke-width="1.1"
          fill="none"
          marker-end={`url(#${arrowId})`}
        >
          <path d="M84 74V130" />
          <path d="M444 74V130" />
          <path d="M116 152H150" />
          <path d="M242 152H276" />
          <path d="M368 152H402" />
          <path d="M196 232V174" />
          <path d="M322 232V174" />
        </g>

        <g text-anchor="middle" dominant-baseline="central">
          <text class="label" x="84" y="55">{copy.ciclomart.media}</text>
          <text class="label" x="421" y="55">{copy.ciclomart.db}</text>
          <text class="label" x="70" y="152">{copy.ciclomart.listing}</text>
          <text class="label" x="196" y="152">{copy.ciclomart.verify}</text>
          <text class="label" x="322" y="152">{copy.ciclomart.cart}</text>
          <text class="label" x="444" y="152">{copy.ciclomart.payment}</text>
          <text class="label" x="261" y="251">{copy.ciclomart.catalog}</text>
        </g>

        <circle cx="480" cy="136" r="3.2" fill="#F97316" />
      </>
    )
  }

  {
    visual === 'courseclash' && (
      <>
        <g fill="#12161B" stroke="#3A4653" stroke-width="1">
          <rect x="24" y="138" width="86" height="44" rx="2" />
          <rect x="176" y="138" width="92" height="44" rx="2" />
          <rect x="344" y="34" width="112" height="40" rx="2" />
          <rect x="344" y="138" width="112" height="40" rx="2" />
          <rect x="344" y="242" width="112" height="40" rx="2" stroke="#F97316" stroke-width="1.2" />
        </g>

        <g
          stroke="#3A4653"
          stroke-width="1.1"
          fill="none"
          marker-end={`url(#${arrowId})`}
        >
          <path d="M110 160H176" />
          <path d="M268 160H300V54H344" />
          <path d="M268 160H344" />
          <path d="M268 160H300V262H344" />
        </g>

        <g stroke="#3A4653" stroke-width="1" fill="none">
          <path d="M456 54H470" />
          <path d="M456 158H470" />
          <path d="M456 262H470" />
          <path d="M470 54V262" />
        </g>

        <g text-anchor="middle" dominant-baseline="central">
          <text class="label" x="67" y="160">{copy.courseclash.web}</text>
          <text class="label" x="222" y="160">{copy.courseclash.gateway}</text>
          <text class="label" x="400" y="54">{copy.courseclash.auth}</text>
          <text class="label" x="400" y="158">{copy.courseclash.activities}</text>
          <text class="label" x="400" y="262">{copy.courseclash.duels}</text>
        </g>

        <text
          class="sub"
          x="486"
          y="158"
          text-anchor="middle"
          transform="rotate(90 486 158)"
        >
          {copy.courseclash.bus}
        </text>

        <path
          d="M344 282V310H67V182"
          fill="none"
          stroke="#F97316"
          stroke-width="1.1"
          stroke-dasharray="3 3"
        />
        <text class="sub accent" x="200" y="306" text-anchor="middle">
          {copy.courseclash.ws}
        </text>
        <circle cx="456" cy="262" r="3.2" fill="#F97316" />
      </>
    )
  }

  {
    visual === 'cyclingsafety' && (
      <>
        <g fill="#12161B" stroke="#3A4653" stroke-width="1">
          <rect x="24" y="60" width="80" height="36" rx="2" />
          <rect x="24" y="116" width="80" height="36" rx="2" />
          <rect x="136" y="88" width="88" height="44" rx="2" />
          <rect x="256" y="88" width="88" height="44" rx="2" stroke="#F97316" stroke-width="1.2" />
          <rect x="376" y="88" width="88" height="44" rx="2" />
          <rect x="376" y="170" width="88" height="44" rx="2" />
          <rect x="136" y="180" width="88" height="36" rx="2" />
        </g>

        <g
          stroke="#3A4653"
          stroke-width="1.1"
          fill="none"
          marker-end={`url(#${arrowId})`}
        >
          <path d="M104 78H120V110H136" />
          <path d="M104 134H120V110H136" />
          <path d="M224 110H256" />
          <path d="M344 110H376" />
          <path d="M420 132V170" />
          <path d="M180 132V180" />
        </g>

        <g text-anchor="middle" dominant-baseline="central">
          <text class="label" x="64" y="78">{copy.cyclingsafety.imu}</text>
          <text class="label" x="64" y="134">{copy.cyclingsafety.gps}</text>
          <text class="label" x="180" y="110">{copy.cyclingsafety.esp}</text>
          <text class="label" x="300" y="110">{copy.cyclingsafety.model}</text>
          <text class="label" x="420" y="110">{copy.cyclingsafety.mqtt}</text>
          <text class="label" x="420" y="192">{copy.cyclingsafety.tb}</text>
          <text class="label" x="180" y="198">{copy.cyclingsafety.sd}</text>
        </g>

        <path d="M24 270H476" stroke="#28303A" stroke-width="1" stroke-dasharray="2 6" />
        <path
          d="M24 270h24l8-14 8 28 8-20h20l8-24 8 44 8-30h22l8-8 8 16h18l8-28 8 56 8-40h24l8 6 8-12h24l8-18 8 34 8-22h24l8-10 8 20 8-12h30"
          fill="none"
          stroke="#A7AFBA"
          stroke-width="1.1"
          opacity="0.85"
          stroke-linejoin="round"
        />
        <circle cx="300" cy="300" r="3.2" fill="#F97316" />
        <circle cx="300" cy="300" r="8" stroke="#F97316" stroke-width="1" opacity="0.5" fill="none" />
        <text class="sub" x="24" y="254">{copy.cyclingsafety.signal}</text>
        <text class="sub accent" x="316" y="304">{copy.cyclingsafety.event}</text>
      </>
    )
  }
</svg>
)}

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 25 / 16;
    object-fit: cover;
    object-position: top center;
  }

  .screenshot-contain {
    object-fit: contain;
    object-position: center;
    background: var(--bg);
  }

  .diagram {
    display: block;
    width: 100%;
    height: auto;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: #a7afba;
  }

  .sub {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    fill: #7f8894;
  }

  .accent {
    fill: #f97316;
  }
</style>
